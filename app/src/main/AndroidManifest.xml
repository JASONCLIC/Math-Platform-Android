<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.android_snack">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidSnack">

        <!-- 设置 MathPlatformMain 为初始界面 -->
        <activity android:name=".MathPlatformMain">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MathPlatformGame" />
        <!-- 注册 SnakeStarView 界面 -->
        <activity android:name=".SnakeStarView" />

        <!-- 注册 PlaneView 界面 -->
        <activity android:name=".PlaneView" />

        <!-- 其他 Activity 注册 -->
        <activity android:name=".SnakeMainActivity" />

        <activity android:name=".PlaneMainActivity" />

    </application>
</manifest>
